PORT=5000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smart-learn

# we generate JWT_SECRET using the command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

NODE_ENV=development

# find groq api key from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
ENABLE_DEBUG_ENDPOINTS=false

ADMIN_NAME=YourAdminName
ADMIN_EMAIL=your-admin-email@gmail.com
ADMIN_PASSWORD=YourStrongPassword123

ADMIN_NEW_EMAIL=your-new-admin-email@gmail.com
ADMIN_NEW_PASSWORD=YourNewStrongPassword123

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_USER_EMAIL=your-gmail-user-email@gmail.com
